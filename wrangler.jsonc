{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bits-portfolio",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "imam.bits.co.id", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}