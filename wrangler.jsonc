{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nurulimam-com",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}